{
  "name": "polymarket-data-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"dist/**\"",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "collector": "tsx src/cli/collector.ts",
    "collect:pm:all": "npm run collector -- all --market-duration all --write-debug-json false",
    "collect:pm:1h": "npm run collector -- all --market-duration 1h --write-debug-json false",
    "collect:pm:4h": "npm run collector -- all --market-duration 4h --write-debug-json false",
    "collect:pm:1d": "npm run collector -- all --market-duration 1d --write-debug-json false",
    "collect:pm:range": "npm run collector -- range --market-duration all --write-debug-json false"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "p-limit": "^7.2.0",
    "pino": "^10.1.0",
    "parquetjs-lite": "^0.8.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
